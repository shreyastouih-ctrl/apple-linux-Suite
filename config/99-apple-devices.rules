# udev rules for Apple devices on Linux
# Place in /etc/udev/rules.d/99-apple-devices.rules

# iPhone / iPad / iPod USB access permissions for libimobiledevice & usbmuxd
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", GROUP="plugdev", MODE="0666"

# Apple Magic Mouse 1 & 2 Bluetooth permission & power saving settings
ACTION=="add", SUBSYSTEM=="bluetooth", ATTR{idVendor}=="05ac", ATTR{idProduct}=="030d", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="bluetooth", ATTR{idVendor}=="05ac", ATTR{idProduct}=="0269", ATTR{power/control}="on"

# Apple Magic Trackpad 1 & 2
ACTION=="add", SUBSYSTEM=="input", ATTR{idVendor}=="05ac", ATTR{idProduct}=="0265", ENV{LIBINPUT_MODEL_APPLE_TOUCHPAD}="1"

# Apple T2 Audio / Touch Bar USB endpoints
SUBSYSTEM=="usb", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="8600", MODE="0666", GROUP="audio"
